# Copy to .env before running Docker Compose or local development.
# Do NOT commit a populated .env file.

NODE_ENV=production
PORT=3000

# Comma-separated allowed browser origins for the API
CORS_ORIGIN=http://localhost:8080

# Optional: increases GitHub API quota. Never expose this to the frontend.
# GITHUB_TOKEN=

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_MS=8000

CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=100

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

LOG_LEVEL=info
